{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"custom": {
			"radius": "2px",
			"duration": { "fast": "0.15s", "base": "0.2s", "flip": "0.24s" },
			"ease": { "flip": "cubic-bezier(0.2, 0.7, 0.2, 1)" }
		},
		"color": {
			"custom": false,
			"customGradient": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "base", "name": "Concrete", "color": "#E9E7E2" },
				{ "slug": "surface", "name": "White", "color": "#FFFFFF" },
				{ "slug": "line", "name": "Line", "color": "#CFCBC2" },
				{ "slug": "muted", "name": "Slate", "color": "#55585E" },
				{ "slug": "contrast", "name": "Graphite", "color": "#16181B" },
				{ "slug": "graphite-2", "name": "Graphite raised", "color": "#22262B" },
				{ "slug": "line-dark", "name": "Line on graphite", "color": "#3A3F46" },
				{ "slug": "steel", "name": "Steel", "color": "#A9AEB5" },
				{ "slug": "accent", "name": "Safety yellow", "color": "#F2C230" },
				{ "slug": "accent-light", "name": "Yellow light", "color": "#FFD24D" },
				{ "slug": "accent-tint", "name": "Yellow tint", "color": "#F7E3A1" },
				{ "slug": "alert", "name": "Alert red", "color": "#B3261E" },
				{ "slug": "field", "name": "Field border", "color": "#6B6F76" }
			]
		},
		"layout": {
			"contentSize": "44rem",
			"wideSize": "80rem"
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [ "px", "em", "rem", "%", "vh", "vw" ],
			"spacingSizes": [
				{ "slug": "10", "name": "1", "size": "0.5rem" },
				{ "slug": "20", "name": "2", "size": "0.75rem" },
				{ "slug": "30", "name": "3", "size": "1rem" },
				{ "slug": "40", "name": "4", "size": "1.5rem" },
				{ "slug": "50", "name": "5", "size": "clamp(2rem, 4vw, 3rem)" },
				{ "slug": "60", "name": "6", "size": "clamp(3rem, 6vw, 5rem)" },
				{ "slug": "70", "name": "7", "size": "clamp(4rem, 9vw, 7.5rem)" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"writingMode": false,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Barlow Condensed",
					"fontFamily": "'Barlow Condensed', 'Arial Narrow', 'Roboto Condensed', sans-serif",
					"fontFace": [
						{
							"fontFamily": "Barlow Condensed",
							"fontStyle": "normal",
							"fontWeight": "600",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/barlow-condensed-600.woff2" ]
						},
						{
							"fontFamily": "Barlow Condensed",
							"fontStyle": "normal",
							"fontWeight": "700",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/barlow-condensed-700.woff2" ]
						}
					]
				},
				{
					"slug": "body",
					"name": "Barlow",
					"fontFamily": "Barlow, system-ui, -apple-system, 'Segoe UI', sans-serif",
					"fontFace": [
						{
							"fontFamily": "Barlow",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/barlow-400.woff2" ]
						},
						{
							"fontFamily": "Barlow",
							"fontStyle": "normal",
							"fontWeight": "500",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/barlow-500.woff2" ]
						},
						{
							"fontFamily": "Barlow",
							"fontStyle": "normal",
							"fontWeight": "600",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/barlow-600.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
				{ "slug": "base", "name": "Base", "size": "1.0625rem", "fluid": { "min": "1rem", "max": "1.125rem" } },
				{ "slug": "medium", "name": "Medium", "size": "1.25rem", "fluid": { "min": "1.125rem", "max": "1.375rem" } },
				{ "slug": "large", "name": "Large", "size": "1.75rem", "fluid": { "min": "1.5rem", "max": "2rem" } },
				{ "slug": "x-large", "name": "Extra large", "size": "2.75rem", "fluid": { "min": "2.125rem", "max": "3.25rem" } },
				{ "slug": "xx-large", "name": "Huge", "size": "3.75rem", "fluid": { "min": "2.75rem", "max": "4.5rem" } },
				{ "slug": "display", "name": "Display", "size": "5rem", "fluid": { "min": "3.25rem", "max": "6.5rem" } }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"top": "0",
				"bottom": "0",
				"left": "clamp(1.25rem, 4vw, 3rem)",
				"right": "clamp(1.25rem, 4vw, 3rem)"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|body",
			"fontSize": "var:preset|font-size|base",
			"lineHeight": "1.6"
		},
		"elements": {
			"heading": {
				"color": { "text": "inherit" },
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontWeight": "700",
					"lineHeight": "1.02",
					"letterSpacing": "-0.005em"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|display",
					"lineHeight": "0.94",
					"textTransform": "uppercase"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var:preset|font-size|x-large",
					"textTransform": "uppercase"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var:preset|font-size|large",
					"fontWeight": "600",
					"lineHeight": "1.1"
				}
			},
			"link": {
				"color": { "text": "inherit" },
				":hover": { "typography": { "textDecoration": "none" } }
			},
			"button": {
				"color": {
					"background": "var:preset|color|accent",
					"text": "var:preset|color|contrast"
				},
				"border": {
					"radius": "var:custom|radius",
					"width": "2px",
					"style": "solid",
					"color": "var(--wp--preset--color--contrast)"
				},
				"spacing": {
					"padding": { "top": "0.8125rem", "bottom": "0.8125rem", "left": "1.375rem", "right": "1.375rem" }
				},
				"typography": {
					"fontFamily": "var:preset|font-family|body",
					"fontSize": "var:preset|font-size|base",
					"fontWeight": "600",
					"lineHeight": "1.2"
				},
				":hover": {
					"color": { "background": "var:preset|color|accent-light", "text": "var:preset|color|contrast" }
				}
			},
			"caption": {
				"color": { "text": "var:preset|color|muted" },
				"typography": { "fontSize": "var:preset|font-size|small" }
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|display",
					"fontSize": "var:preset|font-size|medium",
					"fontWeight": "700",
					"letterSpacing": "0.04em",
					"textTransform": "uppercase"
				},
				"elements": {
					"link": { "color": { "text": "var:preset|color|surface" } }
				}
			},
			"core/navigation": {
				"typography": { "fontSize": "var:preset|font-size|base", "fontWeight": "500" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-landing", "title": "Landing page (no title)", "postTypes": [ "page" ] }
	]
}
